# Core API (loaded from this file after copying to .env)
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ML_SERVICE_URL=http://127.0.0.1:8001

# Auth: use Docker Compose dev for PostgreSQL, Redis, and Mailpit.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://dubsibhai:local-dev-only@127.0.0.1:5432/dubsibhai
REDIS_URL=redis://localhost:6379/0
MONGODB_URL=mongodb://127.0.0.1:27017/dubsibhai
MONGODB_DATABASE=dubsibhai
# Server-only mayor bootstrap. Never use NEXT_PUBLIC_ for these values.
# Set both, then run `uv run python -m app.workers.bootstrap` from apps/api.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Mayor
AUTH_SECRET=development-only-change-before-deployment
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@dubsibhai.local
# Behind Nginx, set this to the exact private proxy network in deployment.
TRUSTED_PROXY_CIDRS=[]

# Optional absolute path to the classifier artifact (default: apps/ml-service/weights/classifier.joblib)
# ML_MODEL_PATH=D:/CSE-4113-Project/apps/ml-service/weights/classifier.joblib
# ML_ROAD_RISK_MODEL_PATH=D:/CSE-4113-Project/apps/ml-service/weights/road-risk.joblib

# Next.js reads apps/web/.env.local; see apps/web/.env.example.
