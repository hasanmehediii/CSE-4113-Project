NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional. Must match GOOGLE_CLIENT_ID in the root .env.
# Register http://localhost:3000 as an authorized JavaScript origin in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Live map defaults to free Leaflet + OpenStreetMap (no key required).
# Set the provider to google and add a browser-restricted Maps JavaScript API key,
# then restart Next.js (rebuild for production).
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
